rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - users can read/write their own data, admins can read all
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow read: if request.auth != null; // Allow reading all users for admin features
    }

    // User subcollections (meals, etc.) - users can access their own data, admins can read all
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Allow collectionGroup queries for reviews
    match /{path=**}/reviews/{reviewId} {
      allow read: if request.auth != null && isAdmin();
    }

    // Complaints collection - users can create/read their own, admins can read/write all
    match /complaints/{complaintId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
      allow update: if request.auth != null && isAdmin(); // Only admins can update status
    }

    // Chats collection - users can read/write their own chat room, admins can access all
    match /chats/{chatRoomId}/{document=**} {
      allow read, write: if request.auth != null && (request.auth.uid == chatRoomId || isAdmin());
    }

    // Menus collection - all authenticated users can read, only admins write
    match /menus/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Config collection - all authenticated users can read, only admins write
    match /config/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }
  }
}